#!/bin/sh
# Schutz vor versehentlichem Committen echter Daten und Zugangsdaten.
# Aktivieren (einmal je Rechner und Kopie des Projekts):  git config core.hooksPath tools/git-hooks
# Nicht umgehen (kein --no-verify). Ist die Datei wirklich in Ordnung, ändere die Regel hier und sag es dem Projektinhaber.

bad=$(git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do
  case "$f" in
    (Stammdaten_*|*/Stammdaten_*|Mitglieder*|*/Mitglieder*) echo "$f" ;;
    (testdata/*.xlsx) ;;
    (config.php|*/config.php|.env|*/.env|dev.env|*/dev.env|*.sql.gz|*.dump|*.sqlite|*.csv|*.xls|*.xlsx|private/*|real-data/*) echo "$f" ;;
  esac
done)

if [ -n "$bad" ]; then
  echo "Commit abgebrochen. Diese Dateien könnten echte Daten oder Zugangsdaten enthalten:" >&2
  echo "$bad" | sed 's/^/  - /' >&2
  echo "Erfundene Testdaten gehören nach testdata/. Echte Daten und Passwörter gehören nie in das Repository." >&2
  exit 1
fi
exit 0
