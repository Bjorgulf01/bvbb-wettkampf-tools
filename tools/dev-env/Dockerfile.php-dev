# PHP 8.4 für Tests und lokale Vorschau, damit auf dem Rechner kein PHP installiert sein muss
FROM php:8.4-cli
# git und zip nur für tools/package.php (Paket für den Webspace). safe.directory, weil /app dem Benutzer des Rechners gehört.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git libzip-dev \
    && docker-php-ext-install pdo_mysql zip \
    && git config --system --add safe.directory /app \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
