# Kopiere diese Datei nach tools/dev-env/.env (genau dieser Name) und trage die Werte ein.
# Die Datei .env wird nie committet (.gitignore und Commit-Schutz).
#
# Jeder Rechner nutzt seine EIGENE Datenbank auf dem NAS. Die Tests löschen alle Tabellen der
# Datenbank, auf die sie zeigen. Zwei Rechner auf derselben Datenbank stören sich gegenseitig.
#   Windows-PC: dbname=bvbb_test_pc     MacBook: dbname=bvbb_test_mac
# NAS-IP: feste Adresse des NAS im Heimnetz (Docker Desktop erreicht sie direkt).
TEST_DB_DSN=mysql:host=NAS-IP;port=3307;dbname=bvbb_test_pc;charset=utf8mb4
TEST_DB_USER=bvbb_test
TEST_DB_PASS=HIER-PASSWORT-AUS-PORTAINER
#
# Unterwegs ohne NAS (nach "--profile local up -d db-local"):
# TEST_DB_DSN=mysql:host=host.docker.internal;port=3308;dbname=bvbb_test_local;charset=utf8mb4
# TEST_DB_PASS=lokal-nur-fuer-tests
